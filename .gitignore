# Reproducible generated figures/tables are rebuilt from code and not committed.
paper/figures/generated/*.pdf
!paper/figures/generated/.gitkeep
paper/tables/generated/*.tex
!paper/tables/generated/.gitkeep

# Compiled manuscript artifact (rebuilt by Makefile/CI)
paper/main.pdf

# Confidential/local research-governance records.
# Detailed AI-use logs, prompts/outputs, historical research files, and provenance evidence
# must not be committed to this public repository.
.local-research-audit/
