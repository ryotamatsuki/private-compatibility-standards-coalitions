# Python
__pycache__/
*.pyc
.venv/

# Verification / temporary build outputs
build/

# LaTeX generated files
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
*.synctex.gz
*.toc
